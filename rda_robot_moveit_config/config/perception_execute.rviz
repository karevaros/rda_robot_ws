Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /MotionPlanning1
        - /PlanningScene1
      Splitter Ratio: 0.5
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Cell Size: 0.5
      Plane Cell Count: 20
      Color: 160; 160; 164
      Enabled: true
    # 현재(실제) 로봇 — /joint_states(gazebo broadcaster) 기반. 계획 상태와 구분해서 봄.
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel(현재)
      Description Topic:
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
        Value: /robot_description
      Enabled: false
      Visual Enabled: true
      Collision Enabled: false
      Alpha: 1
    # Gazebo D435i 원본 포인트클라우드(센서가 보는 것).
    - Class: rviz_default_plugins/PointCloud2
      Name: DepthCloud
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /d435i/depth/points
      Style: Points
      Size (Pixels): 2
      Color Transformer: AxisColor
      Axis: Z
      Decay Time: 0
      Enabled: true
    # 센싱 결과가 planning scene 의 옥토맵(충돌객체)으로 들어온 모습(복셀).
    - Class: moveit_rviz_plugin/PlanningScene
      Name: PlanningScene
      Enabled: true
      Move Group Namespace: ""
      Planning Scene Topic: /monitored_planning_scene
      Robot Description: robot_description
      Scene Geometry:
        Scene Alpha: 0.9
        Scene Color: 50; 230; 50
        Scene Display Time: 0.2
        Show Scene Geometry: true
        Voxel Coloring: Z-Axis
        Voxel Rendering: Occupied Voxels
      Scene Robot:
        Show Robot Collision: false
        Show Robot Visual: false
        Robot Alpha: 0.5
    # ★ 핵심: MotionPlanning — 엔드이펙터에 붙는 interactive marker 를 마우스로 끌어
    #   목표 자세를 잡고, 아래 MotionPlanning 패널의 Plan → Execute 로 실제 실행한다.
    #   (Query.Show Goal State: true + Tools 의 Interact 가 있어야 드래그가 된다)
    - Class: moveit_rviz_plugin/MotionPlanning
      Name: MotionPlanning
      Enabled: true
      Move Group Namespace: ""
      Planning Group: arm
      Planning Scene Topic: /monitored_planning_scene
      Robot Description: robot_description
      Trajectory Topic: /display_planned_path
      Planned Path:
        Show Robot Visual: true
        Show Trail: false
        Loop Animation: false
        Trajectory Topic: /display_planned_path
      Scene Geometry:
        Show Scene Geometry: false
      Scene Robot:
        Show Robot Visual: true
        Robot Alpha: 0.6
      Query:
        Show Goal State: true
        Show Start State: false
        Interactive Marker Size: 0.2
    # Stage 4: 인지된 열매(구) — fruit_detector 가 world 좌표로 발행.
    - Class: rviz_default_plugins/MarkerArray
      Name: DetectedFruits
      Namespaces:
        {}
      Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /detected_fruits
      Enabled: true
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: false
      Marker Scale: 0.3
      Show Names: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: world
    Frame Rate: 30
  Tools:
    # ⚠ Interact 를 맨 앞(기본 활성 도구)에 둬야 EE 마커를 바로 마우스로 끌 수 있다.
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Distance: 3.0
      Focal Point:
        X: 0.4
        Y: -0.2
        Z: 0.8
      Pitch: 0.35
      Yaw: 2.2
      Target Frame: world
Window Geometry:
  Displays:
    collapsed: false
  MotionPlanning:
    collapsed: false
  Height: 900
  Width: 1500
  QMainWindow State: ""
